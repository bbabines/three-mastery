{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@harness/*": ["./harness/*"]
    }
  },
  "include": [
    "harness",
    "concepts",
    "drills",
    "placement",
    "checkpoints",
    "cross",
    "electives",
    "solutions",
    "scripts",
    "experiments",
    "vite.config.ts"
  ]
}
